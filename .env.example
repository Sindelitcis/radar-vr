# Copie para .env e preencha. O .env fica fora do Git.

# E-mail (Gmail com senha de app: myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Histórico de preços (isthereanydeal.com/apps/my)
ITAD_API_KEY=

# Telegram: token do @BotFather
TELEGRAM_TOKEN=

# WhatsApp Cloud API (developers.facebook.com). Ver docs/06_canais.md:
# a Meta bloqueia remetente estrangeiro para números +55.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=

# Operação (valores padrão entre parênteses)
# RADAR_PORTA=8765                 porta do microsserviço
# RADAR_DRY_RUN=0                  1 = nenhuma mensagem sai da máquina
# RADAR_FALHAR_CANAIS=             ex.: telegram  (força falha para testar contingência)
# RADAR_COLETA_PARALELA=4          requisições simultâneas à Steam
# RADAR_PERSONALIZACAO_PARALELA=4  assinantes processados em paralelo
# RADAR_CACHE_REDACAO=1            reaproveita texto entre assinantes de mesmo interesse
# RADAR_FORCAR_IPV4=1              evita o timeout de IPv6 até api.telegram.org
# RADAR_PERFIS=perfis.json         arquivo de assinantes
# OLLAMA_URL=http://127.0.0.1:11434
