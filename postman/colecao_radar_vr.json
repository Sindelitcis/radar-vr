    {
      "name": "Ollama",
      "item": [
        {
          "name": "6. Modelos instalados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ollama}}/api/tags",
              "host": [
                "{{ollama}}"
              ],
              "path": [
                "api",
                "tags"
              ]
            },
            "description": "Verificação de disponibilidade. Use 127.0.0.1: clientes em Node resolvem localhost como ::1 e o Ollama escuta apenas em IPv4."
          }
        },
        {
          "name": "7. Redigir uma chamada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{modelo}}\",\n  \"stream\": false,\n  \"format\": \"json\",\n  \"options\": { \"temperature\": 0.2 },\n  \"system\": \"Voce e redator de um boletim diario de audio sobre jogos de realidade virtual na Steam, em portugues do Brasil. Escreve para ser OUVIDO: frases curtas, diretas, sem adjetivo de propaganda. Todos os numeros ja vem prontos no material recebido; voce nunca inventa, estima ou altera um numero.\",\n  \"prompt\": \"Escreva UMA frase de noticia de radio sobre o fato abaixo. Responda APENAS com JSON valido: {\\\"linha\\\": \\\"a frase, no maximo 28 palavras\\\"}. Regras: comece pelo nome do jogo; escreva com acentuacao correta; nao escreva numero de versao nem data; nao opine sobre valer a pena. JOGO: Half-Life: Alyx | FATO: recebeu um anuncio do desenvolvedor ontem: Steam Frame Update\"\n}"
            },
            "url": {
              "raw": "{{ollama}}/api/generate",
              "host": [
                "{{ollama}}"
              ],
              "path": [
                "api",
                "generate"
              ]
            },
            "description": "Chamada equivalente à de src/redacao.py. O modelo redige apenas eventos com texto livre; fatos numéricos vêm de regra determinística."
          }
        }
      ]
