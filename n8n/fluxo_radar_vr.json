    {
      "parameters": {
        "jsCode": "// O CSV acumula todas as edições; aqui ficam apenas as manchetes da\n// execução mais recente.\n//\n// O arquivo é gravado com BOM para que o Excel reconheça a acentuação, o que\n// faz a primeira coluna chegar como \"\\uFEFFpublicada_em\". As chaves são\n// normalizadas antes de qualquer leitura.\nconst limpar = obj => Object.fromEntries(\n  Object.entries(obj).map(([k, v]) => [k.replace(/^\\uFEFF/, '').trim(), v])\n);\n\nconst linhas = $input.all().map(i => limpar(i.json));\nif (!linhas.length) return [];\n\nconst ultima = linhas.map(l => l.publicada_em).sort().pop();\n\nreturn linhas\n  .filter(l => l.publicada_em === ultima)\n  .map(l => ({\n    json: {\n      posicao: Number(l.posicao),\n      secao: l.secao,\n      tipo: l.tipo,\n      titulo: l.nome,\n      chamada: l.linha,\n      preco: l.preco,\n      preco_cheio: l.preco_cheio,\n      desconto: Number(l.desconto || 0),\n      url: l.url\n    }\n  }));"
      },
      "id": "aa000000-0000-4000-8000-000000000006",
      "name": "Manchetes desta edição",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 290]
    }
